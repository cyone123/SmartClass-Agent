# SmartClass Docker deployment environment.
# Copy this file to `.env.docker` and replace placeholder secrets before running:
#   docker compose --env-file .env.docker up -d --build

# Public ports
FRONTEND_BIND=0.0.0.0
DEBUG_BIND=127.0.0.1
FRONTEND_PORT=8080
BACKEND_PORT=8000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ONLYOFFICE_PORT=8082
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Public URL used by backend-generated download, preview, and OnlyOffice callback URLs.
# Local single-machine default:
PUBLIC_API_BASE_URL=

# Database
DB_HOST=
DB_USER=postgres
DB_PASSWORD=
DB_NAME=smartclass

# Required for durable chat runs
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=sc
REDIS_OPERATION_TIMEOUT_SECONDS=2
REDIS_COMMAND_POOL_SIZE=20
REDIS_READER_POOL_SIZE=100
REDIS_ACTIVE_TTL_SECONDS=86400
REDIS_TERMINAL_RETENTION_SECONDS=604800
REDIS_TOKEN_BATCH_INTERVAL_MS=40
REDIS_TOKEN_BATCH_MAX_CHARS=1024
REDIS_READ_BLOCK_MS=15000
REDIS_READ_BATCH_SIZE=200
REDIS_APPEND_MAX_RETRIES=2

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=86400

# Main model
MODEL=
API_KEY=
BASE_URL=

# Embeddings
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=

# Structured output model
STRUCTED_MDOEL=
STRUCTED_API_KEY=
STRUCTED_BASE_URL=
STRUCTURED_TIMEOUT_MS=30000
STRUCTURED_WARMUP_ENABLED=true
STRUCTURED_FALLBACK_ENABLED=true
STRUCTURED_PROMPT_CACHE_ENABLED=false

# Small/fast model. Used as structured output fallback and follow-up suggestions generation.
SMALL_MDOEL=
SMALL_API_KEY=
SMALL_BASE_URL=

# Long-term memory reflection and selection
MEMORY_MODEL=
MEMORY_API_KEY=
MEMORY_BASE_URL=
STRUCTURED_FAST_MODEL=
STRUCTURED_FAST_API_KEY=
STRUCTURED_FAST_BASE_URL=

# Thread-level context compression. Disabled by default; when enabled, explicit
# CONTEXT_COMPRESSION_* model settings win, otherwise backend falls back to
# memory/structured/small/main model settings.
CONTEXT_COMPRESSION_ENABLED=false
CONTEXT_COMPRESSION_MODEL=
CONTEXT_COMPRESSION_API_KEY=
CONTEXT_COMPRESSION_BASE_URL=
CONTEXT_COMPRESSION_TIMEOUT_MS=30000
CONTEXT_COMPRESSION_TRIGGER_TOKENS=24000
CONTEXT_COMPRESSION_KEEP_RECENT_TURNS=6
CONTEXT_COMPRESSION_MAX_OUTPUT_TOKENS=3000
CONTEXT_COMPRESSION_MAX_PREFACE_CHARS=6000

# Durable background long-term-memory reflection
# Enable this on exactly one backend process when deploying multiple processes.
MEMORY_REFLECTION_WORKER_ENABLED=true
MEMORY_REFLECTION_SHADOW_MODE=false
MEMORY_REFLECTION_POLL_SECONDS=1.0
MEMORY_REFLECTION_PROFILE_SNAPSHOT_MAX_CHARS=4000
MEMORY_REFLECTION_EXPERIENCE_SNAPSHOT_MAX_CHARS=16000
MEMORY_REFLECTION_EVALUATION_TIMEOUT_SECONDS=30
MEMORY_REFLECTION_TERMINAL_RETENTION_DAYS=30

# Speech and video
STT_MODEL=
STT_BASE_URL=
STT_API_KEY=
STT_LANGUAGE=
VIDEO_VISION_MODEL=
VIDEO_VISION_BASE_URL=
VIDEO_VISION_API_KEY=
VIDEO_FFMPEG_BIN=ffmpeg

# File limits
FILE_UPLOAD_MAX_SIZE_BYTES=20971520
KNOWLEDGE_FILE_ALLOWED_EXTENSIONS=.docx,.pdf,.txt,.md,.markdown,.csv,.json
ATTACHMENT_FILE_ALLOWED_EXTENSIONS=.docx,.pdf,.mp4
VOICE_FILE_ALLOWED_EXTENSIONS=.webm,.wav,.mp3,.m4a,.mp4,.ogg

# Storage
STORAGE_BACKEND=minio
STORAGE_DOWNLOAD_MODE=proxy
STORAGE_PRESIGNED_URL_TTL_SECONDS=900
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-strong-minio-password
MINIO_BUCKET=bucket
MINIO_REGION=
MINIO_SECURE=false

# Agent workspace execution. You can create daytona snapshot through the script: backend/create_daytona_snapshot.py
WORKSPACE_EXECUTION_BACKEND=local
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
DAYTONA_SNAPSHOT=
DAYTONA_IMAGE=
DAYTONA_CLEANUP_POLICY=delete
DAYTONA_NETWORK_BLOCK_ALL=true
DAYTONA_NETWORK_ALLOW_LIST=
DAYTONA_AUTO_STOP_INTERVAL_MINUTES=15
DAYTONA_AUTO_ARCHIVE_INTERVAL_MINUTES=1440
DAYTONA_AUTO_DELETE_INTERVAL_MINUTES=10080
DAYTONA_CREATE_TIMEOUT_SECONDS=60
DAYTONA_EXECUTION_TIMEOUT_SECONDS=120
DAYTONA_FILE_SYNC_TIMEOUT_SECONDS=1800
DAYTONA_REMOTE_ROOT=/workspace/smartclass

# Observability
OBSERVABILITY_ENABLED=true
OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_TRACE_JSONL_ENABLED=false
OBSERVABILITY_MAX_FIELD_CHARS=1000
OBSERVABILITY_MAX_JSONL_BYTES_PER_EVENT=20000

OTEL_ENABLED=true
OTEL_SERVICE_NAME=smartclass-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORTER_OTLP_INSECURE=true

PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_HISTOGRAM_BUCKETS=0.05,0.1,0.25,0.5,1,2.5,5,10,30,60
PROMETHEUS_EXPORT_MODE=endpoint

